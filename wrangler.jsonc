{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "apex",
  "compatibility_date": "2026-09-20",
  "workers_dev": true,
  "preview_urls": true,
  "assets": { "directory": "./dist", "html_handling": "auto-trailing-slash", "not_found_handling": "404-page" },
  "previews": {},
  "send_metrics": false
}
