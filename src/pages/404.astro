---
import Pane from '../components/Pane.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getBlogContent } from '../lib/content';
import { deriveUsedTags, orderTagsByPostCount } from '../lib/tags';

const { posts, tagDefinitions } = await getBlogContent();
const siteTags = orderTagsByPostCount(deriveUsedTags(posts, tagDefinitions), posts);
---

<SiteLayout
  title="ページが見つかりません"
  description="このページは見つかりませんでした。ホームに戻るか、記事一覧からお探しください。"
  siteTags={siteTags}
>
  <Pane as="section" class="not-found-pane" ariaLabelledBy="not-found-title">
    <h1 id="not-found-title">404 — ページが見つかりません</h1>
    <p>お探しのページは存在しないか、移動した可能性があります。</p>
    <nav aria-label="ページの移動先">
      <a href="/">ホーム</a>
      <a href="/posts">記事一覧</a>
    </nav>
  </Pane>
</SiteLayout>

<style>
  .not-found-pane {
    min-height: 100%;
    align-content: start;
    gap: 1.5rem;
  }

  h1 {
    font-size: clamp(2rem, 4vw, 3rem);
  }

  p {
    color: var(--muted);
    font-family: var(--sans);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;

    a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }
</style>
