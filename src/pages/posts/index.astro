---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getPublicPosts } from '../../lib/posts';
import { formatTimestamp } from '../../domain/posts';
const posts = await getPublicPosts();
---
<SiteLayout title="記事一覧" description="daiksud.meの公開記事一覧。">
  <h1>記事一覧</h1>
  {posts.length === 0 ? <p>公開記事はまだありません。</p> : (
    <ul class="post-list">
      {posts.map(({ data }) => (
        <li>
          <h2><a href={`/posts/${data.slug}`}>{data.title}</a></h2>
          <p><time datetime={data.publishedAt}>{formatTimestamp(data.publishedAt)}</time></p>
          <p>{data.description}</p>
        </li>
      ))}
    </ul>
  )}
</SiteLayout>
