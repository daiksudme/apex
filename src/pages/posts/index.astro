---
import { getCollection } from 'astro:content';
import Pane from '../../components/Pane.astro';
import PostList from '../../components/PostList.astro';
import TerminalPrompt from '../../components/TerminalPrompt.astro';
import { tags as configuredTags } from '../../config/site';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { sortPostsByPublishedAt } from '../../lib/posts';
import { deriveUsedTags, orderTagsByConfiguration } from '../../lib/tags';

const posts = sortPostsByPublishedAt(await getCollection('posts'));
const siteTags = orderTagsByConfiguration(
  deriveUsedTags(posts, configuredTags),
  configuredTags,
);
const description = 'つくったもの、学んだこと、考えたことを書き残した記事の一覧です。';
---

<SiteLayout title="Posts" description={description} siteTags={siteTags}>
  <div class="posts-index-page">
    <Pane
      class="posts-index-pane"
      title="Posts"
      headingId="posts-index-pane-heading"
      titleElement="h1"
    >
      <span slot="meta" class="pane-label" lang="en">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</span>
      <header class="posts-index-intro">
        <div class="posts-index-commands" lang="en">
          <p class="command-line">
            <TerminalPrompt />
            <span class="command">cd posts/</span>
          </p>
          <p class="command-line">
            <TerminalPrompt path="~/posts" />
            <span class="command">ls</span>
          </p>
        </div>
      </header>
      <PostList posts={posts} />
    </Pane>
  </div>
</SiteLayout>

<style>
  .posts-index-page {
    min-width: 0;
    min-height: 100%;
  }

  .posts-index-pane {
    min-height: 100%;
  }


  .posts-index-intro {
    padding-block: 1rem 1.5rem;
    border-bottom: 1px solid var(--border);

    .posts-index-commands {
      display: grid;
      gap: 0.35rem;
    }
  }

</style>
