---
import { getCollection } from 'astro:content';
import Pane from '../../components/Pane.astro';
import PostList from '../../components/PostList.astro';
import TerminalPrompt from '../../components/TerminalPrompt.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { sortPostsByPublishedAt } from '../../lib/posts';

const posts = sortPostsByPublishedAt(await getCollection('posts'));
const description = 'つくったもの、学んだこと、考えたことを書き残した記事の一覧です。';
---

<SiteLayout title="記事" description={description}>
  <div class="posts-index-page">
    <Pane
      class="posts-index-pane"
      title="Posts"
      headingId="posts-index-pane-heading"
      titleElement="div"
      ariaLabelledBy="posts-index-title"
    >
      <span slot="meta" class="pane-label" lang="en">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</span>
      <header class="posts-index-intro">
        <div class="posts-index-commands" lang="en">
          <p class="command-line">
            <TerminalPrompt />
            <span class="command">cd posts/</span>
          </p>
          <p class="command-line">
            <TerminalPrompt path="~/posts" />
            <span class="command">ls</span>
          </p>
        </div>
        <h1 id="posts-index-title">記事</h1>
        <p class="posts-index-description">{description}</p>
      </header>
      <PostList posts={posts} />
    </Pane>
  </div>
</SiteLayout>

<style>
  .posts-index-page {
    min-width: 0;
    min-height: 100%;
  }

  .posts-index-pane {
    min-height: 100%;
  }

  .posts-index-intro {
    padding-block: 1rem 1.5rem;
    border-bottom: 1px solid var(--border);

    .posts-index-commands {
      display: grid;
      gap: 0.35rem;
    }

    h1 {
      margin-block: 1.4rem 0.65rem;
      font-size: clamp(2rem, 4vw, 3rem);
    }

    .posts-index-description {
      max-inline-size: 70ch;
      color: var(--muted);
      font-family: var(--sans);
      font-size: 1rem;
      line-height: 1.85;
      word-break: normal;
      word-break: auto-phrase;
    }
  }
</style>
