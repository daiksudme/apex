---
import { render, type CollectionEntry } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getPublicPosts } from '../../lib/posts';
import { formatTimestamp, tags } from '../../domain/posts';
export async function getStaticPaths() {
  return (await getPublicPosts()).map((post) => ({ params: { slug: post.data.slug }, props: { post } }));
}
interface Props { post: CollectionEntry<'posts'> }
const { post } = Astro.props;
const { data } = post;
const { Content } = await render(post);
---
<SiteLayout title={data.title} description={data.description}>
  <article>
    <h1>{data.title}</h1>
    <p>{data.description}</p>
    <p>公開: <time datetime={data.publishedAt}>{formatTimestamp(data.publishedAt)}</time></p>
    {data.updatedAt && <p>更新: <time datetime={data.updatedAt}>{formatTimestamp(data.updatedAt)}</time></p>}
    {data.tags.length > 0 && <ul class="tags" aria-label="タグ">{data.tags.map((tag) => <li>{tags[tag]}</li>)}</ul>}
    {data.heroImage && <img class="hero" src={data.heroImage.src} alt={data.heroImage.alt} />}
    <div class="prose"><Content /></div>
  </article>
</SiteLayout>
