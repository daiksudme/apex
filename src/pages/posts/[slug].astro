---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { tags as configuredTags } from '../../config/site';
import PostLayout from '../../layouts/PostLayout.astro';
import { deriveUsedTags, orderTagsByConfiguration, type TagDefinition } from '../../lib/tags';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const siteTags = orderTagsByConfiguration(
    deriveUsedTags(posts, configuredTags),
    configuredTags,
  );

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, siteTags },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
  siteTags: TagDefinition[];
}

const { post, siteTags } = Astro.props;
const { Content } = await render(post);
---

<PostLayout
  title={post.data.title}
  description={post.data.description}
  slug={post.id}
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}
  tags={post.data.tags}
  siteTags={siteTags}
>
  <Content />
</PostLayout>
