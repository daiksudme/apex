---
import { render, type CollectionEntry } from 'astro:content';
import { getBlogContent } from '../lib/content';
import PostLayout from '../layouts/PostLayout.astro';
import { deriveUsedTags, orderTagsByPostCount, type TagDefinition } from '../lib/tags';

export async function getStaticPaths() {
  const { posts, tagDefinitions } = await getBlogContent();
  const siteTags = orderTagsByPostCount(deriveUsedTags(posts, tagDefinitions), posts);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, siteTags },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
  siteTags: TagDefinition[];
}

const { post, siteTags } = Astro.props;
const { Content } = await render(post);
---

<PostLayout
  title={post.data.title}
  description={post.data.description}
  slug={post.id}
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}
  tags={post.data.tags}
  siteTags={siteTags}
>
  <Content />
</PostLayout>
