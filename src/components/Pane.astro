---
type PaneElement = 'section' | 'aside' | 'footer' | 'article';

type PaneTitleElement = 'h1' | 'h2' | 'div';

type HeadingProps =
  | { title: string; headingId: string; titleElement?: PaneTitleElement }
  | { title?: never; headingId?: never; titleElement?: never };

type Props = HeadingProps & {
  as?: PaneElement;
  id?: string;
  class?: string;
  tabindex?: number;
  ariaLabel?: string;
  ariaLabelledBy?: string;
};

const {
  as = 'section',
  id,
  class: className,
  title,
  headingId,
  titleElement = 'h2',
  tabindex,
  ariaLabel,
  ariaLabelledBy,
  ...rest
} = Astro.props;

const Tag = as;
const Title = titleElement;
---

<Tag
  id={id}
  class:list={['pane', className]}
  aria-labelledby={ariaLabelledBy ?? headingId}
  aria-label={ariaLabel}
  tabindex={tabindex}
  {...rest}
>
  {title && headingId && (
    <header class="pane-heading" lang="en">
      <Title id={headingId} class="pane-title"><span class="chevron" aria-hidden="true">›</span>{title}</Title>
      <slot name="meta" />
    </header>
  )}
  <slot />
  <slot name="footer" />
</Tag>

<style>
  :where(.pane) {
    display: grid;
    align-content: start;
    min-width: 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 1.4rem;

    @media (max-width: 1180px) {
      padding: 1.2rem;
    }

    @media (max-width: 640px) {
      padding: 1.1rem;
    }
  }

  .pane-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.85rem;

    .pane-title {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      gap: 0.65rem;
      font-size: 1.08rem;
      line-height: 1.4;
      font-feature-settings: "palt";
      text-wrap: balance;

      @media (max-width: 640px) {
        font-size: 1rem;
      }
    }
  }

  :is(.posts-index-pane, .tags-index-pane) > .pane-heading {
    padding-block: 0.35rem 1rem;
  }

  :is(.posts-index-pane, .tags-index-pane) > .pane-heading .pane-title {
    gap: 0.8rem;
    color: var(--text);
    font-size: clamp(1.75rem, 3vw, 2.35rem);
    font-weight: 750;
    letter-spacing: -0.045em;
    line-height: 1.15;
    margin: 0;
  }

  :is(.posts-index-pane, .tags-index-pane) > .pane-heading .pane-title .chevron {
    color: var(--cyan);
    font-size: 1.15em;
  }

  :is(.posts-index-pane, .tags-index-pane) > .pane-heading .pane-label {
    align-self: end;
    padding-bottom: 0.15rem;
  }

  @media (max-width: 640px) {
    :is(.posts-index-pane, .tags-index-pane) > .pane-heading .pane-title {
      font-size: clamp(1.55rem, 8vw, 1.9rem);
    }
  }
</style>
