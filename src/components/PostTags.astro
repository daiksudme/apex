---
interface Props {
  tags: string[];
  class?: string;
}

const { tags, class: className } = Astro.props;
---

{tags.length > 0 && (
  <ul class:list={['post-tags', className]} aria-label="タグ" lang="en">
    {tags.map((tag) => (
      <li><span class="post-tag">#{tag}</span></li>
    ))}
  </ul>
)}

<style>
  .post-summary-tags {
    margin-top: 0.15rem;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;

    .post-tag {
      display: inline-block;
      border: 1px solid var(--blue);
      border-radius: 4px;
      padding: 0.2rem 0.55rem;
      color: var(--blue);
      background: color-mix(in srgb, var(--blue) 8%, transparent);
      font-size: 0.75rem;
    }
  }
</style>
