---
import type { CollectionEntry } from 'astro:content';
import { navigation, profile, site, tags } from '../config/site';
import SiteLayout from '../layouts/SiteLayout.astro';
import { sortPostsByPublishedAt } from '../lib/posts';
import Icon from './Icon.astro';
import Pane from './Pane.astro';
import PostList from './PostList.astro';
import TerminalPrompt from './TerminalPrompt.astro';

interface Props {
  posts: CollectionEntry<'posts'>[];
}

const { posts } = Astro.props;
const latestPosts = sortPostsByPublishedAt(posts).slice(0, 3);
---

<SiteLayout>
  <div class="dashboard">
    <Pane class="welcome-pane" title="Welcome" headingId="welcome-heading" titleElement="div">
      <p class="command-line" lang="en"><TerminalPrompt /> <span class="command">cat welcome.txt</span></p>
      <h1>つくる。<wbr />試す。<wbr />書き残す。</h1>
      <p class="welcome-description">{site.description}</p>
      <p class="tagline" lang="en">{site.tagline}</p>
      <div class="welcome-links">
        <p class="command-line" lang="en"><TerminalPrompt /> <span class="command">ls</span></p>
        <nav aria-label="ホームのセクション">
          {navigation.slice(1).map((item) => (
            <a href={item.href} lang="en"><span aria-hidden="true">[ </span>{item.label.toLowerCase()}<span aria-hidden="true"> ]</span></a>
          ))}
        </nav>
      </div>
      <p class="command-line idle-prompt" aria-hidden="true"><TerminalPrompt /> <span class="cursor"></span></p>
    </Pane>

    <Pane id="profile" class="profile-pane" title="Profile" headingId="profile-heading" tabindex={-1}>
      <div class="profile-top">
        <img class="avatar" src={profile.avatarUrl} alt="daiksudのGitHubアバター" width="160" height="160" decoding="async" referrerpolicy="no-referrer" />
        <div>
          <p class="eyebrow" lang="en">Profile</p>
          <h3>{profile.name}</h3>
          <p class="profile-role" lang="en">{profile.role}</p>
        </div>
      </div>
      <dl class="profile-details" lang="en">
        <div><dt><Icon name="location" /><span>Location</span></dt><dd>{profile.location}</dd></div>
        <div><dt><Icon name="github" /><span>GitHub</span></dt><dd><a href={profile.githubUrl}>{profile.githubLabel}</a></dd></div>
        <div><dt><Icon name="link" /><span>Website</span></dt><dd><a href="/">{site.name}</a></dd></div>
      </dl>
      <p class="profile-bio">{profile.bio}</p>
      <p class="profile-note" lang="en"><span class="tag-dot" aria-hidden="true"></span>Building in public</p>
    </Pane>

    <Pane id="posts" class="posts-pane" title="Latest Posts" headingId="posts-heading" tabindex={-1}>
      <span slot="meta" class="pane-label" lang="en">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</span>
      <PostList posts={latestPosts} headingLevel="h3" />
      <p slot="footer" class="pane-footnote" lang="en"><span aria-hidden="true">// </span>Small steps. Continuous learning.</p>
    </Pane>

    <Pane id="tags" class="tags-pane" title="Tags" headingId="tags-heading" tabindex={-1}>
      <span slot="meta" class="pane-label" lang="en">interests</span>
      <ul class="tag-list" lang="en">
        {tags.map((tag) => (
          <li><span id={`tag-${tag.slug}`} class="tag" data-tone={tag.tone} tabindex="-1">#{tag.slug}</span></li>
        ))}
      </ul>
      <p class="tags-note">これから書いていきたいテーマ。</p>
    </Pane>

    <Pane class="commits-pane" title="Recent Commits" headingId="commits-heading">
      <a slot="meta" class="pane-link" href={site.commitsUrl} lang="en">GitHub <Icon name="arrow" size={16} /></a>
      <div class="repository-summary">
        <span class="repository-icon"><Icon name="branch" size={26} /></span>
        <div>
          <p class="repository-name">{site.name}</p>
          <p class="repository-description">このサイトも、少しずつ育てています。</p>
        </div>
      </div>
      <a class="text-link" href={site.commitsUrl}>GitHubで更新履歴を見る <Icon name="arrow" size={16} /></a>
    </Pane>
  </div>
</SiteLayout>

<style>
  .dashboard {
    display: grid;
    height: 100%;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    grid-template-rows: auto auto minmax(auto, 1fr);
    grid-template-areas:
      "welcome profile"
      "posts tags"
      "posts commits";
    gap: var(--pane-gap);
    align-items: start;

    @media (max-width: 1180px) {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    }

    @media (max-width: 960px) {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto minmax(auto, 1fr) auto auto;
      grid-template-areas:
        "welcome"
        "profile"
        "posts"
        "tags"
        "commits";
    }
  }

  h1 {
    @media (max-width: 960px) {
      font-size: clamp(2rem, 4.1vw, 2.8rem);
    }

    @media (max-width: 640px) {
      font-size: 2rem;
      margin-block: 1.35rem 1rem;
    }
  }

  .welcome-pane {
    grid-area: welcome;
    grid-template-rows: auto auto auto auto auto minmax(0, 1fr) auto;
    align-content: stretch;
    min-height: 420px;

    > :global(.pane-heading) + .command-line {
      margin-top: 1rem;
    }

    @media (max-width: 1180px) {
      min-height: 460px;
    }

    @media (max-width: 960px) {
      min-height: 0;
    }
  }

  .welcome-description {
    inline-size: 100%;
    max-inline-size: none;
    font-family: var(--sans);
    font-size: 1.05rem;
    line-height: 1.95;
    word-break: normal;
    word-break: auto-phrase;

    @media (max-width: 640px) {
      font-size: 0.95rem;
    }
  }

  .tagline {
    color: var(--muted);
    font-size: 1rem;
    margin-top: 1.2rem;

    @media (max-width: 640px) {
      font-size: 0.78rem;
    }
  }

  .welcome-links {
    align-self: end;
    padding-top: 1.4rem;

    nav {
      display: flex;
      flex-wrap: wrap;
      column-gap: 1ch;
      margin-block: 0.15rem;
      line-height: 1;
    }

    a {
      display: inline-grid;
      grid-auto-flow: column;
      align-items: center;
      min-height: 44px;
      gap: 0.25rem;
      font-size: 0.95rem;
      white-space: nowrap;

      @media (max-width: 640px) {
        font-size: 0.85rem;
      }
    }
  }

  .idle-prompt {
    margin-top: 0.25rem;
  }

  .profile-pane {
    --profile-leading-column: minmax(110px, 132px);
    --profile-column-gap: 1.3rem;
    grid-area: profile;
    align-self: stretch;
    min-height: 420px;

    > :global(.pane-heading) + .profile-top {
      margin-top: 1rem;
    }

    @media (max-width: 1180px) {
      --profile-leading-column: 100px;
      --profile-column-gap: 1rem;
      min-height: 460px;
    }

    @media (max-width: 960px) {
      --profile-leading-column: 110px;
      min-height: 0;
    }

    @media (max-width: 640px) {
      --profile-leading-column: 100px;
    }
  }

  .profile-top {
    display: grid;
    grid-template-columns: var(--profile-leading-column) minmax(0, 1fr);
    align-items: center;
    column-gap: var(--profile-column-gap);

    h3 {
      font-size: clamp(1.5rem, 2vw, 1.9rem);
      line-height: 1.3;
      margin-block: 0.35rem 0.5rem;
      font-feature-settings: "palt";
      text-wrap: balance;
    }

    .profile-role {
      font-size: 0.76rem;
      color: var(--muted);
    }
  }

  .avatar {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border: 1px solid var(--border);
    border-radius: 3px;
    background: var(--selection);
  }

  .profile-details {
    display: grid;
    gap: 0.65rem;
    margin-top: 1.5rem;
    font-size: 0.78rem;

    > div {
      display: grid;
      grid-template-columns: var(--profile-leading-column) minmax(0, 1fr);
      column-gap: var(--profile-column-gap);
      align-items: start;
    }

    dt {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      gap: 0.65rem;
      color: var(--muted);

      :global(.icon) {
        width: 18px;
        height: 18px;
      }
    }

    dd {
      min-width: 0;
    }

    a {
      text-decoration: underline;
    }

    @media (max-width: 640px) {
      font-size: 0.72rem;
    }
  }

  .profile-bio {
    border-top: 1px solid var(--border);
    padding-top: 1rem;
    margin-top: 1.25rem;
    font-family: var(--sans);
    font-size: 0.9rem;
    line-height: 1.8;
    word-break: normal;
    word-break: auto-phrase;

    @media (max-width: 640px) {
      font-size: 0.85rem;
    }
  }

  .profile-note {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
    color: var(--green);
    margin-top: 1rem;
    font-size: 0.8rem;
  }

  .pane-link {
    display: inline-grid;
    grid-auto-flow: column;
    align-items: center;
    gap: 0.5rem;
    min-height: 28px;
    font-size: 0.72rem;
    text-decoration: underline;
  }

  .posts-pane {
    grid-area: posts;
    grid-template-rows: auto minmax(0, 1fr) auto;
    align-content: stretch;
    align-self: stretch;
    min-height: 364px;

    @media (max-width: 640px) {
      min-height: 340px;
    }
  }

  .pane-footnote {
    padding-top: 0.85rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.7rem;
  }

  .tags-pane {
    grid-area: tags;
  }

  .tag-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(6.5rem, 1fr));
    gap: 0.65rem;
    margin-top: 1rem;
  }

  .tag {
    display: inline-block;
    border: 1px solid var(--tone);
    color: var(--tone);
    border-radius: 4px;
    padding: 0.3rem 0.6rem;
    font-size: 0.78rem;
    background: color-mix(in srgb, var(--tone) 8%, transparent);
  }

  .tags-note {
    margin-top: 0.85rem;
    color: var(--muted);
    font-family: var(--sans);
    font-size: 0.75rem;
    word-break: normal;
    word-break: auto-phrase;
  }

  .commits-pane {
    grid-area: commits;
    align-self: stretch;

    @media (max-width: 960px) {
      align-self: start;
    }
  }

  .repository-summary {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: 0.8rem;
    margin-block: 1.1rem;
  }

  .repository-icon {
    color: var(--green);
    padding-top: 0.1rem;
  }

  .repository-name {
    color: var(--blue);
    font-size: 0.95rem;
    font-weight: 600;
  }

  .repository-description {
    margin-top: 0.25rem;
    font-family: var(--sans);
    font-size: 0.78rem;
    color: var(--muted);
    word-break: normal;
    word-break: auto-phrase;
  }

  .text-link {
    display: inline-grid;
    grid-auto-flow: column;
    justify-content: start;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--sans);
    font-size: 0.82rem;
    min-height: 32px;
    text-decoration: underline;
    word-break: normal;
    word-break: auto-phrase;
  }
</style>
