---
import type { CollectionEntry } from 'astro:content';
import { navigation, profile, site, topics } from '../config/site';
import SiteLayout from '../layouts/SiteLayout.astro';
import { sortPostsByPublishedAt } from '../lib/posts';
import Icon from './Icon.astro';
import Pane from './Pane.astro';
import PostList from './PostList.astro';
import TerminalPrompt from './TerminalPrompt.astro';

interface Props {
  posts: CollectionEntry<'posts'>[];
}

const { posts } = Astro.props;
const latestPosts = sortPostsByPublishedAt(posts).slice(0, 3);
---

<SiteLayout>
  <div class="dashboard">
    <Pane class="welcome-pane" title="Welcome" headingId="welcome-heading" titleElement="div">
      <p class="command-line" lang="en"><TerminalPrompt /> <span class="command">cat welcome.txt</span></p>
      <h1>つくる。<wbr />試す。<wbr />書き残す。</h1>
      <p class="welcome-description">{site.description}</p>
      <p class="tagline" lang="en">{site.tagline}</p>
      <div class="welcome-links">
        <p class="command-line" lang="en"><TerminalPrompt /> <span class="command">ls</span></p>
        <nav aria-label="ホームのセクション">
          {navigation.slice(1).map((item) => (
            <a href={item.href} lang="en"><span aria-hidden="true">[ </span>{item.label.toLowerCase()}<span aria-hidden="true"> ]</span></a>
          ))}
        </nav>
      </div>
      <p class="command-line idle-prompt" aria-hidden="true"><TerminalPrompt /> <span class="cursor"></span></p>
    </Pane>

    <Pane id="about" class="profile-pane" title="Profile" headingId="profile-heading" tabindex={-1}>
      <div class="profile-top">
        <img class="avatar" src={profile.avatarUrl} alt="daiksudのGitHubアバター" width="160" height="160" decoding="async" referrerpolicy="no-referrer" />
        <div>
          <p class="eyebrow" lang="en">About me</p>
          <h3>{profile.name}</h3>
          <p class="profile-role" lang="en">{profile.role}</p>
        </div>
      </div>
      <dl class="profile-details" lang="en">
        <div><dt><Icon name="location" /><span>Location</span></dt><dd>{profile.location}</dd></div>
        <div><dt><Icon name="github" /><span>GitHub</span></dt><dd><a href={profile.githubUrl}>{profile.githubLabel}</a></dd></div>
        <div><dt><Icon name="link" /><span>Website</span></dt><dd><a href="/">{site.name}</a></dd></div>
      </dl>
      <p class="profile-bio">{profile.bio}</p>
      <p class="profile-note" lang="en"><span class="topic-dot" aria-hidden="true"></span>Building in public</p>
    </Pane>

    <Pane id="posts" class="posts-pane" title="Latest Posts" headingId="posts-heading" tabindex={-1}>
      <span slot="meta" class="pane-label" lang="en">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</span>
      <PostList posts={latestPosts} headingLevel="h3" />
      <p slot="footer" class="pane-footnote" lang="en"><span aria-hidden="true">// </span>Small steps. Continuous learning.</p>
    </Pane>

    <Pane id="tags" class="tags-pane" title="Tags" headingId="tags-heading" tabindex={-1}>
      <span slot="meta" class="pane-label" lang="en">interests</span>
      <ul class="tag-list" lang="en">
        {topics.map((topic) => (
          <li><span id={`topic-${topic.slug}`} class="tag" data-tone={topic.tone} tabindex="-1">#{topic.slug}</span></li>
        ))}
      </ul>
      <p class="tags-note">これから書いていきたいテーマ。</p>
    </Pane>

    <Pane class="commits-pane" title="Recent Commits" headingId="commits-heading">
      <a slot="meta" class="pane-link" href={site.commitsUrl} lang="en">GitHub <Icon name="arrow" size={16} /></a>
      <div class="repository-summary">
        <span class="repository-icon"><Icon name="branch" size={26} /></span>
        <div>
          <p class="repository-name">{site.name}</p>
          <p class="repository-description">このサイトも、少しずつ育てています。</p>
        </div>
      </div>
      <a class="text-link" href={site.commitsUrl}>GitHubで更新履歴を見る <Icon name="arrow" size={16} /></a>
    </Pane>
  </div>
</SiteLayout>
