---
const logos = {
  github: [
    'M7 8 8.5 5.5 11 7h2l2.5-1.5L17 8',
    'M6.5 9.5V12c0 3.7 2.3 6 5.5 6s5.5-2.3 5.5-6V9.5',
    'M9.5 11.5h.01M14.5 11.5h.01',
    'M10 14c1 .8 3 .8 4 0',
    'M12 18v2',
  ],
  x: [
    'M5 5l5.2 5.2',
    'M13.8 13.8 19 19',
    'M19 5l-5.2 5.2',
    'M10.2 13.8 5 19',
  ],
  zenn: [
    'M5 18 14 6',
    'M10 18 19 6',
    'M8 6h6',
    'M10 18h6',
  ],
} as const;

interface Props {
  name: keyof typeof logos;
  size?: number;
}

const { name, size = 20 } = Astro.props;
---

<svg
  class:list={['brand-logo', `brand-logo-${name}`]}
  data-brand={name}
  data-logo-style="original"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {logos[name].map((path) => <path d={path} />)}
</svg>

<style>
  :where(.brand-logo) {
    display: inline-block;
    vertical-align: middle;
  }
</style>
