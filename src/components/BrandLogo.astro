---
const logos = {
  // Custom line art: use GitHub's official mark only as a visual reference for proportions and recognition.
  github: [
    'M8.4 17.9v-1.45c-2.55-.5-4.15-2.15-4.15-4.85 0-1.4.5-2.55 1.4-3.45L5.45 5.7l3.1 1.1c1-.3 2.15-.45 3.45-.45 1.25 0 2.4.15 3.45.45l3.1-1.1-.2 2.45c.9.9 1.4 2.05 1.4 3.45 0 2.7-1.6 4.35-4.15 4.85v1.45',
    'M8.4 17.9v2.1M15.6 17.9V20',
    'M8.4 18.55c-1.5.55-2.8.35-3.7-.55-.55-.55-.85-1.3-1.45-1.5-.45-.15-.85-.05-1.2.15',
  ],
  // Custom line art: redraw X's official mark from visual proportions without reusing its SVG path data.
  x: [
    'M4.6 4.3h3.2l11.7 15.4h-3.2L4.6 4.3Z',
    'M18.8 4.3 5.2 19.7',
  ],
  // Custom line art: redraw Zenn's official mark from visual proportions without reusing its SVG path data.
  zenn: [
    'M4 20 13.5 4h3.7L7.7 20H4Z',
    'M11.9 20 16.4 12.3H20L15.5 20h-3.6Z',
  ],
} as const;

interface Props {
  name: keyof typeof logos;
  size?: number;
}

const { name, size = 20 } = Astro.props;
---

<svg
  class:list={['brand-logo', `brand-logo-${name}`]}
  data-brand={name}
  data-logo-style="original"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {logos[name].map((path) => <path d={path} />)}
</svg>

<style>
  :where(.brand-logo) {
    display: inline-block;
    vertical-align: middle;
  }
</style>
