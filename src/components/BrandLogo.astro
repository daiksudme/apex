---
const logos = {
  github: [
    'M8.2 17.8v-1.6c-2.4-.4-4-1.8-4-4.4 0-1.4.5-2.5 1.4-3.4L5.3 6l3.2 1.2c1-.3 2.2-.5 3.5-.5s2.5.2 3.5.5L18.7 6l-.3 2.8c.9.9 1.4 2 1.4 3.4 0 2.6-1.6 4-4 4.4v1.6',
    'M8.2 17.8v2M15.8 17.8v2',
    'M8.2 18.5c-2.2.7-3.7-.4-4.8-1.8',
  ],
  x: [
    'M5 4.5h3.1l10.9 15h-3.1L5 4.5Z',
    'M18.5 4.5h-2.7L5.5 19.5h2.7l10.3-15Z',
  ],
  zenn: [
    'M4.5 20 15.6 4.2',
    'M11.3 20 20 7.2',
  ],
} as const;

interface Props {
  name: keyof typeof logos;
  size?: number;
}

const { name, size = 20 } = Astro.props;
---

<svg
  class:list={['brand-logo', `brand-logo-${name}`]}
  data-brand={name}
  data-logo-style="original"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {logos[name].map((path) => <path d={path} />)}
</svg>

<style>
  :where(.brand-logo) {
    display: inline-block;
    vertical-align: middle;
  }
</style>
