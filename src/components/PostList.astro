---
import type { CollectionEntry } from 'astro:content';
import { formatDate, formatIsoDate } from '../lib/date';
import Icon from './Icon.astro';
import PostTags from './PostTags.astro';

interface Props {
  posts: CollectionEntry<'posts'>[];
  headingLevel?: 'h2' | 'h3';
}

const { posts, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
---

{posts.length === 0 ? (
  <div class="empty-state post-list-empty">
    <span class="empty-icon"><Icon name="terminal" size={32} /></span>
    <p class="empty-command" lang="en"><span class="chevron" aria-hidden="true">›</span> ls posts/</p>
    <Heading class="empty-state-title">まだ記事はありません。</Heading>
    <p>つくったもの、学んだこと、考えたこと。<br />ここから少しずつ書き残していきます。</p>
  </div>
) : (
  <ul class="post-list">
    {posts.map((post) => {
      const titleId = `post-${post.id}-title`;
      return (
        <li class="post-list-item">
          <article class="post-summary" aria-labelledby={titleId}>
            <time class="post-summary-date" datetime={formatIsoDate(post.data.publishedAt)}>
              {formatDate(post.data.publishedAt)}
            </time>
            <Heading id={titleId} class="post-summary-title">
              <a href={`/posts/${post.id}`}>
                <span>{post.data.title}</span>
                <Icon name="arrow" size={18} />
              </a>
            </Heading>
            <p class="post-summary-description">{post.data.description}</p>
            <PostTags tags={post.data.tags} class="post-summary-tags" />
          </article>
        </li>
      );
    })}
  </ul>
)}
