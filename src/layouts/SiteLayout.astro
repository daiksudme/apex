---
import Icon from '../components/Icon.astro';
import Pane from '../components/Pane.astro';
import TerminalPrompt from '../components/TerminalPrompt.astro';
import { getPageTitle } from '../lib/page-title';
import { navigation, profile, site, topics } from '../config/site';
import '../styles/global.css';
interface Props { title?: string; description?: string }
const { title, description = site.description } = Astro.props;
const pageTitle = getPageTitle(title);
const year = new Date().getFullYear();
const pathname = Astro.url.pathname;
const isCurrentNavigationItem = (href: string) => href === pathname;
const isActiveNavigationItem = (href: string) =>
  href === '/posts'
    ? pathname === '/posts' || pathname.startsWith('/posts/')
    : isCurrentNavigationItem(href);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1a1b26" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">本文へスキップ</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label={`${site.name} ホーム`}>
        {site.name}<span class="cursor" aria-hidden="true"></span>
      </a>
      <nav class="header-nav" aria-label="メインナビゲーション">
        {navigation.slice(1).map((item) => (
          <a
            href={item.href}
            lang="en"
            class:list={{ 'is-active': isActiveNavigationItem(item.href) }}
            aria-current={isCurrentNavigationItem(item.href) ? 'page' : undefined}
          ><span aria-hidden="true">[ </span>{item.label.toLowerCase()}<span aria-hidden="true"> ]</span></a>
        ))}
      </nav>
      <p class="header-tagline" lang="en">{site.tagline}</p>
    </header>

    <Pane as="aside" class="sidebar-pane" ariaLabel="サイトメニュー">
      <nav class="sidebar-nav" aria-label="ページナビゲーション">
        {navigation.map((item) => (
          <a
            href={item.href}
            lang="en"
            class:list={{ 'is-active': isActiveNavigationItem(item.href) }}
            aria-current={isCurrentNavigationItem(item.href) ? 'page' : undefined}
          >
            <Icon name={item.icon} /><span>{item.label}</span>
          </a>
        ))}
      </nav>
      <nav class="sidebar-topics" aria-label="トピック">
        <p class="eyebrow" lang="en"><span aria-hidden="true">// </span>Topics</p>
        <ul lang="en">
          {topics.map((topic) => (
            <li><a href={`/#topic-${topic.slug}`} data-tone={topic.tone}><span class="topic-dot" aria-hidden="true"></span>#{topic.slug}</a></li>
          ))}
        </ul>
      </nav>
      <p class="sidebar-note" lang="en">A personal blog about technology, creativity, and a better tomorrow.</p>
    </Pane>

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <Pane as="footer" class="footer-pane">
      <p class="footer-command" lang="en"><TerminalPrompt /> <span>echo <span class="string">&quot;Thank you for visiting!&quot;</span></span></p>
      <div class="footer-meta">
        <a href={profile.githubUrl} aria-label="daiksudのGitHub"><Icon name="github" size={22} /></a>
        <p>&copy; {year} {site.name}</p>
      </div>
    </Pane>
  </body>
</html>
