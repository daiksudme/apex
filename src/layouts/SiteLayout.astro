---
import Icon from '../components/Icon.astro';
import Pane from '../components/Pane.astro';
import TerminalPrompt from '../components/TerminalPrompt.astro';
import { getPageTitle } from '../lib/page-title';
import { navigation, profile, site, topics } from '../config/site';
import '../styles/global.css';
interface Props { title?: string; description?: string }
const { title, description = site.description } = Astro.props;
const pageTitle = getPageTitle(title);
const year = new Date().getFullYear();
const pathname = Astro.url.pathname;
const isCurrentNavigationItem = (href: string) => href === pathname;
const isActiveNavigationItem = (href: string) =>
  href === '/posts'
    ? pathname === '/posts' || pathname.startsWith('/posts/')
    : isCurrentNavigationItem(href);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1a1b26" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
    <!-- First-paint header CSS: keep colocated here so header geometry is stable before bundled CSS arrives. -->
    <style is:inline>
      body { margin: 0; }
      .skip-link {
        position: absolute;
        z-index: 10;
        top: 0.75rem;
        left: 1rem;
        padding: 0.75rem 1rem;
        color: var(--bg);
        background: var(--cyan);
        transform: translateY(-180%);
      }
      .skip-link:focus { transform: translateY(0); }
      .site-header {
        box-sizing: border-box;
        grid-area: header;
        min-height: 84px;
        display: grid;
        grid-template-columns: max-content minmax(0, 1fr) auto;
        align-items: center;
        gap: 2rem;
        padding: 1.25rem 2rem;
        border-bottom: 1px solid var(--border);
        background: var(--surface);
      }
      .brand {
        display: inline-grid;
        grid-auto-flow: column;
        justify-self: start;
        width: max-content;
        align-items: center;
        gap: 0.45rem;
        color: var(--text);
        font-size: 1.9rem;
        font-weight: 700;
        letter-spacing: -0.04em;
        line-height: 1.2;
      }
      .brand:hover { text-decoration: none; color: var(--blue); }
      .header-nav {
        display: grid;
        grid-auto-flow: column;
        justify-content: end;
        gap: 1.25rem;
        font-size: 0.9rem;
      }
      .header-nav a { white-space: nowrap; }
      .header-nav a span { color: var(--muted); }
      .header-nav a[aria-current='page'],
      .header-nav a.is-active { color: var(--cyan); text-decoration: underline; }
      .header-nav a[aria-current='page'] span,
      .header-nav a.is-active span { color: var(--cyan); }
      .header-tagline {
        max-width: 8rem;
        border-left: 1px solid var(--border);
        padding-left: 1.5rem;
        font-size: 0.72rem;
        color: var(--muted);
      }
      @media (max-width: 1180px) {
        .header-tagline { display: none; }
      }
      @media (max-width: 960px) {
        .header-nav { gap: 0.75rem; font-size: 0.8rem; }
      }
      @media (max-width: 640px) {
        .site-header {
          min-height: 72px;
          grid-template-columns: minmax(0, 1fr);
          padding: 1.2rem;
        }
        .brand { font-size: 1.6rem; }
        .header-nav { display: none; }
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main-content">本文へスキップ</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label={`${site.name} ホーム`}>
        {site.name}<span class="cursor" aria-hidden="true"></span>
      </a>
      <nav class="header-nav" aria-label="メインナビゲーション">
        {navigation.slice(1).map((item) => (
          <a
            href={item.href}
            lang="en"
            class:list={{ 'is-active': isActiveNavigationItem(item.href) }}
            aria-current={isCurrentNavigationItem(item.href) ? 'page' : undefined}
          ><span aria-hidden="true">[ </span>{item.label.toLowerCase()}<span aria-hidden="true"> ]</span></a>
        ))}
      </nav>
      <p class="header-tagline" lang="en">{site.tagline}</p>
    </header>

    <Pane as="aside" class="sidebar-pane" ariaLabel="サイトメニュー">
      <nav class="sidebar-nav" aria-label="ページナビゲーション">
        {navigation.map((item) => (
          <a
            href={item.href}
            lang="en"
            class:list={{ 'is-active': isActiveNavigationItem(item.href) }}
            aria-current={isCurrentNavigationItem(item.href) ? 'page' : undefined}
          >
            <Icon name={item.icon} /><span>{item.label}</span>
          </a>
        ))}
      </nav>
      <nav class="sidebar-topics" aria-label="トピック">
        <p class="eyebrow" lang="en"><span aria-hidden="true">// </span>Topics</p>
        <ul lang="en">
          {topics.map((topic) => (
            <li><a href={`/#topic-${topic.slug}`} data-tone={topic.tone}><span class="topic-dot" aria-hidden="true"></span>#{topic.slug}</a></li>
          ))}
        </ul>
      </nav>
      <p class="sidebar-note" lang="en">A personal blog about technology, creativity, and a better tomorrow.</p>
    </Pane>

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <Pane as="footer" class="footer-pane">
      <p class="footer-command" lang="en"><TerminalPrompt /> <span>echo <span class="string">&quot;Thank you for visiting!&quot;</span></span></p>
      <div class="footer-meta">
        <a href={profile.githubUrl} aria-label="daiksudのGitHub"><Icon name="github" size={22} /></a>
        <p>&copy; {year} {site.name}</p>
      </div>
    </Pane>
  </body>
</html>

<style>
  body {
    --sidebar-width: 200px;
    margin: 0;
    min-height: 100svh;
    display: grid;
    grid-template-columns:
      var(--pane-gap)
      var(--sidebar-width)
      var(--pane-gap)
      minmax(0, 1fr)
      var(--pane-gap);
    grid-template-rows:
      auto
      var(--pane-gap)
      minmax(0, 1fr)
      var(--pane-gap)
      auto
      var(--pane-gap);
    grid-template-areas:
      "header header header header header"
      ". . . . ."
      ". sidebar . main ."
      ". sidebar . . ."
      ". sidebar . footer ."
      ". . . . .";

    @media (max-width: 1180px) {
      --sidebar-width: 176px;
    }

    @media (max-width: 640px) {
      grid-template-columns: var(--pane-gap) minmax(0, 1fr) var(--pane-gap);
      grid-template-rows:
        auto
        var(--pane-gap)
        auto
        var(--pane-gap)
        minmax(0, 1fr)
        var(--pane-gap)
        auto
        var(--pane-gap);
      grid-template-areas:
        "header header header"
        ". . ."
        ". sidebar ."
        ". . ."
        ". main ."
        ". . ."
        ". footer ."
        ". . .";
    }
  }

  .sidebar-pane {
    grid-area: sidebar;
    grid-template-rows: auto auto minmax(0, 1fr);
    align-content: stretch;
    align-items: start;
    gap: 2rem;
    padding: 2rem 1.25rem;

    @media (max-width: 1180px) {
      padding-inline: 1rem;
    }

    @media (max-width: 640px) {
      grid-template-rows: auto;
      padding: 0.5rem 0.75rem;
    }
  }

  .sidebar-nav {
    display: grid;
    gap: 0.4rem;

    a {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      gap: 0.8rem;
      min-height: 44px;
      padding: 0.6rem 0.75rem;
      color: var(--muted);
      border-left: 3px solid transparent;
      border-radius: 3px;
      font-size: 0.95rem;

      &:hover {
        color: var(--blue);
        background: var(--selection);
        text-decoration: none;
      }

      &[aria-current='page'],
      &.is-active {
        border-left-color: var(--blue);
        background: var(--selection);
        color: var(--blue);
      }
    }

    @media (max-width: 640px) {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 0.1rem;

      a {
        grid-template-columns: auto auto;
        justify-content: center;
        min-width: 0;
        gap: 0.2rem;
        padding: 0.45rem 0.2rem;
        border-left: 0;
        border-bottom: 2px solid transparent;
        font-size: clamp(0.62rem, 2.7vw, 0.76rem);
        white-space: nowrap;

        &[aria-current='page'],
        &.is-active {
          border-bottom-color: var(--blue);
        }
      }

      & :global(.icon) {
        width: 14px;
        height: 14px;
      }
    }

    @media (max-width: 360px) {
      a {
        grid-template-columns: minmax(0, 1fr);
        gap: 0;
        padding-inline: 0.1rem;
      }

      & :global(.icon) {
        display: none;
      }
    }
  }

  .sidebar-topics {
    padding-top: 1.75rem;
    border-top: 1px solid var(--border);

    ul {
      display: grid;
      margin-top: 0.7rem;
    }

    a {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      gap: 0.8rem;
      min-height: 38px;
      padding-block: 0.35rem;
      color: var(--muted);
      font-size: 0.8rem;
    }

    @media (max-width: 640px) {
      display: none;
    }
  }

  .sidebar-note {
    align-self: end;
    padding-top: 2rem;
    font-size: 0.76rem;
    color: var(--muted);
    line-height: 1.8;

    @media (max-width: 640px) {
      display: none;
    }
  }

  main {
    grid-area: main;
    min-width: 0;
  }

  .footer-pane {
    grid-area: footer;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    padding: 1.2rem 1.4rem;
    font-size: 0.78rem;

    @media (max-width: 640px) {
      grid-template-columns: minmax(0, 1fr);
      font-size: 0.72rem;
    }
  }

  .footer-command {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 0.65rem;
    row-gap: 0.3rem;

    @media (max-width: 420px) {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .string {
    color: var(--yellow);
  }

  .footer-meta {
    display: grid;
    grid-auto-flow: column;
    align-items: center;
    gap: 1rem;
    color: var(--muted);

    a {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      color: var(--text);
    }

    p {
      border-left: 1px solid var(--border);
      padding-left: 1rem;
    }

    @media (max-width: 640px) {
      justify-self: start;
    }
  }
</style>
