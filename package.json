{
  "name": "apex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "26.10.0",
    "pnpm": "12.6.0"
  },
  "scripts": {
    "check": "astro check",
    "build": "astro build",
    "test": "vitest run",
    "test:ci": "node --test tests/ci/preview.node.mjs",
    "test:smoke": "node scripts/ci/smoke.mjs",
    "test:unit": "vitest run --exclude tests/content.build.test.mjs",
    "test:integration": "vitest run tests/content.build.test.mjs",
    "test:acceptance": "pnpm build && node scripts/ci/acceptance.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.1",
    "astro": "7.3.3",
    "satteri": "0.10.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "vitest": "5.0.1",
    "wrangler": "4.136.3"
  }
}
