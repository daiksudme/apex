{
  "name": "apex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4",
    "node": "26.10.0"
  },
  "scripts": {
    "dev": "bun run --bun astro dev",
    "check": "bun run --bun astro check",
    "build": "bun run --bun astro build",
    "test": "bun test ./src ./tests/content.build.test.mjs",
    "test:ci": "bun test ./tests/ci/preview.test.mjs && python3 -B -m unittest discover -s tests/ci -p 'test_*.py'",
    "test:smoke": "bun scripts/ci/smoke.mjs",
    "test:unit": "bun test ./src",
    "test:integration": "bun test ./tests/content.build.test.mjs",
    "test:acceptance": "bun run build && bun scripts/ci/acceptance.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.1",
    "@astrojs/rss": "4.0.19",
    "astro": "7.3.3",
    "satteri": "0.10.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/bun": "1.4.4",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "wrangler": "4.136.3"
  },
  "trustedDependencies": ["esbuild", "workerd"]
}
